# rag-starter — all optional. Copy to .env and edit only what you need.

# --- storage / chunking (defaults are sensible) ---
# RAG_DATA_DIR=./data
# RAG_STORE_DIR=./.chroma
# RAG_COLLECTION=docs
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=4

# --- embeddings ---
# 'default' = local ONNX MiniLM, no API key, runs offline after first download.
# 'openai'  = OpenAI text-embedding-3-small (needs OPENAI_API_KEY).
# RAG_EMBED_BACKEND=default
# OPENAI_API_KEY=

# --- optional: synthesized cited answers (rag_answer / POST /answer) ---
# Without this key, rag_answer returns ranked passages for the host LLM to answer.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
